m name and the role name from the seed.\n-- ref() is how models point at each other. It's also how dbt works out the run order.\nselect\n    p.player_id,\n    p.player_name,\n    p.team_id,\n    t.team_name,\n    p.role_code,\n    coalesce(r.role_name, 'Unknown')    as role_name\nfrom LEAGUE_DB.DEV.stg_players p\njoin LEAGUE_DB.DEV.stg_teams t\n    on p.team_id = t.team_id\nleft join LEAGUE_DB.DEV.player_roles r\n    on p.role_code = r.role_code", "relation_name": "LEAGUE_DB.DEV.dim_players", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T21:27:14.099919Z", "completed_at": "2026-11-09T21:27:14.108113Z"}, {"name": "execute", "started_at": "2026-11-09T21:27:14.108608Z", "completed_at": "2026-11-09T21:27:16.472677Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.3739113807678223, "adapter_response": {"_message": "SUCCESS 0", "code": "SUCCESS", "rows_affected": 0, "query_id": "01c84dc7-020d-157a-0033-e0e3004394ea"}, "message": "SUCCESS 0", "failures": null, "unique_id": "model.cricket_dbt.fct_balls", "compiled": true, "compiled_code": "-- goes to: cricket_dbt/models/marts/fct_balls.sql\n-- Step 6: incremental. The first run builds every ball. After that, only balls newer\n-- than what's already in the table. unique_key: a re-sent ball updates instead of duplicating.\n\n\nselect\n    b.ball_id,\n    b.match_id,\n    m.match_date,\n    m.venue_city,\n    b.innings,\n    b.over_no,\n    b.ball_no,\n    b.batter_id,\n    b.bowler_id,\n    b.ball_outcome,\n    b.runs_off_bat,\n    b.extras,\n    b.total_runs,\n    b.is_wicket,\n    b.is_ball_faced,\n    b.ball_ts\nfrom LEAGUE_DB.DEV.stg_balls b\njoin LEAGUE_DB.DEV.stg_matches m\n    on b.match_id = m.match_id\n\n\nwhere b.ball_ts > (select max(ball_ts) from LEAGUE_DB.DEV.fct_balls)\n", "relation_name": "LEAGUE_DB.DEV.fct_balls", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-09T21:27:16.342996Z", "completed_at"